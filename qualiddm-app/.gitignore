# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NUNCA commitar valor real de segredo.
# Os dois modelos abaixo são exceções: só têm rótulos e instruções, nenhum
# segredo. Sem eles, quem clonar o repositório não sabe o que configurar.
.env*
!.env.example
!.env.secure.example

# typescript
*.tsbuildinfo
next-env.d.ts

# logs do servidor de desenvolvimento (gerados por next dev)
next-dev.log
next-dev.err.log
.next-dev.pid

# arquivos enviados pelos usuários ficam no servidor, não no Git
/storage/
