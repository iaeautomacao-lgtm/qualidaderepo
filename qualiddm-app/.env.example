APP_NAME=QualiDDM
APP_URL=https://seudominio.com.br

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cpaneluser_qualiddm
MYSQL_USER=cpaneluser_qualiddm
MYSQL_PASSWORD=troque-esta-senha
MYSQL_CONNECTION_LIMIT=8
MYSQL_SSL=false

SESSION_SECRET=gere-um-segredo-longo-com-32-ou-mais-caracteres
SESSION_COOKIE_NAME=qualiddm_session
SESSION_DAYS=7

# Senha com que todo acesso novo nasce, e a que "Resetar senha" devolve.
# Uma senha igual para todos so e aceitavel porque a troca no primeiro acesso e
# OBRIGATORIA: users.trocar_senha fica em 1 e o servidor recusa qualquer rota de
# dados enquanto estiver assim.
# Se trocar este valor, gere um hash novo e atualize
# database/cpanel/10-senha-padrao.sql -- os dois tem de dizer a mesma senha.
AUTH_SENHA_PADRAO=QualiDDM@2026
AUTH_SENHA_MINIMA=8

UPLOAD_MAX_FILE_BYTES=52428800
# video/mpeg e video/mp4 sao o rotulo que Windows e Chrome dao para .mpeg e
# .mp4 de AUDIO. Sem eles, gravacao de ligacao legitima e recusada.
UPLOAD_ALLOWED_MIME_TYPES=audio/mpeg,audio/mp3,audio/x-mpeg,audio/mpeg3,audio/wav,audio/x-wav,audio/wave,audio/mp4,audio/m4a,audio/x-m4a,audio/aac,audio/ogg,audio/opus,audio/webm,audio/flac,video/mpeg,video/mp4,application/pdf,text/plain,text/csv,application/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
UPLOAD_ALLOWED_EXTENSIONS=.mp3,.mpeg,.mpg,.mpga,.wav,.m4a,.mp4,.aac,.ogg,.opus,.webm,.flac,.pdf,.txt,.csv,.xls,.xlsx

CORS_ALLOWED_ORIGINS=https://seudominio.com.br

# IA / Gemini
# Nunca use NEXT_PUBLIC_ aqui. Esta chave deve existir somente no servidor.
AI_PROVIDER=gemini
GEMINI_API_KEY=cole-sua-chave-gemini-aqui
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_TRANSCRIPT_CHARS=120000

# Apenas para desenvolvimento local. Em producao, deixe false.
QUALITALK_DEV_AUTH_BYPASS=false
