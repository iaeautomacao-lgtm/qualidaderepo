# ---------------------------------------------------------------------------
# MODELO DE CONFIGURAÇÃO DE PRODUÇÃO — este arquivo NÃO contém segredo real.
#
# Onde este arquivo vira configuração de verdade:
#   - desenvolvimento: copie para `.env.local` na RAIZ do projeto (aqui mesmo,
#     ao lado de package.json). Nunca dentro de src/ nem de public/.
#   - produção no cPanel: NÃO suba arquivo nenhum. Preencha os valores no painel
#     "Setup Node.js App" > Environment Variables. Assim o segredo não existe em
#     disco e não entra em backup de arquivos.
#
# Por que a raiz é segura: o navegador só baixa o que está em `public/`.
# Arquivo na raiz nunca é servido. O que VAZA é variável com prefixo
# NEXT_PUBLIC_, que o Next injeta dentro do JavaScript do navegador.
#
# Regras inegociáveis:
#   1. NUNCA prefixe nada aqui com NEXT_PUBLIC_. Nenhuma destas variáveis pode
#      chegar ao navegador.
#   2. NUNCA commite `.env`, `.env.local` ou qualquer arquivo com valor real.
#      O .gitignore já cobre `.env*` — não remova essa linha.
#   3. Rotacione a chave se ela aparecer em print, log, commit, chat ou ticket.
#   4. Segredo de produção não se reaproveita em desenvolvimento, e vice-versa.
# ---------------------------------------------------------------------------

APP_NAME=QualiDDM
APP_URL=https://seudominio.com.br

# Precisa ser exatamente "production". Com qualquer outro valor o bypass de
# autenticação abaixo continua ativo e o sistema fica acessível SEM SENHA.
NODE_ENV=production

# --- banco -----------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cpaneluser_qualiddm
MYSQL_USER=cpaneluser_qualiddm
MYSQL_PASSWORD=troque-por-uma-senha-forte-do-mysql
MYSQL_CONNECTION_LIMIT=8
MYSQL_SSL=false

# --- sessão ----------------------------------------------------------------
# Gere com: openssl rand -base64 48
# O valor de fábrica ("dev-only-change-me") é público neste repositório: quem o
# conhece consegue forjar sessão. Trocar não é opcional.
SESSION_SECRET=gere-um-segredo-com-openssl-rand-base64-48
SESSION_COOKIE_NAME=qualiddm_session
SESSION_DAYS=7

# Em desenvolvimento este bypass entrega um administrador falso para a
# aplicação ser navegável antes do banco existir. Em produção, DEVE ser false.
QUALITALK_DEV_AUTH_BYPASS=false

# --- upload ----------------------------------------------------------------
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_ALLOWED_MIME_TYPES=audio/mpeg,audio/mp3,audio/wav,audio/x-wav,audio/mp4,audio/m4a,application/pdf,text/plain,text/csv,application/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
UPLOAD_ALLOWED_EXTENSIONS=.mp3,.mpeg,.wav,.m4a,.mp4,.pdf,.txt,.csv,.xls,.xlsx

# --- CORS ------------------------------------------------------------------
# Lista fechada. Vazio significa nenhuma origem externa autorizada, que é o
# padrão correto enquanto não houver cliente fora do próprio domínio.
CORS_ALLOWED_ORIGINS=https://seudominio.com.br

# --- inteligência artificial -----------------------------------------------
# A chave é lida apenas por src/server/services/gemini.js, que só é importado
# por rotas de API. Ela nunca é enviada ao navegador.
AI_PROVIDER=gemini
GEMINI_API_KEY=cole-a-chave-real-somente-no-servidor
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_TRANSCRIPT_CHARS=120000
